# AURA — .env.example
#
# Copy this file to ".env" and fill in real values there. ".env" is
# git-ignored and must never be committed. Never paste a real API key
# into any .py file — only into .env.

# ---------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------
# Which AI provider to use: gemini | ollama | fallback
# - gemini   : cloud AI (Google Gemini free tier) — requires GEMINI_API_KEY.
#              Handles general conversation ("how are you", "what is
#              Docker") as well as desktop actions.
# - ollama   : local AI via an Ollama server on this machine — fully
#              offline once the model is pulled.
# - fallback : no AI at all — deterministic keyword parser, plus a small
#              set of hardcoded identity/greeting replies. Always works,
#              zero setup, but doesn't answer open-ended questions.
#
# If the configured provider fails for any reason (missing/invalid key,
# quota exceeded, timeout, network down, Ollama not running), AURA
# automatically falls back to the offline parser rather than crashing or
# going silent. Note: this fallback is separate from, and unrelated to,
# wake-word detection below — wake-word gating never involves an AI
# provider at all, by design.
AI_PROVIDER=fallback

# --- Gemini ---
# Get a free-tier key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (optional, fully local/offline AI) ---
# Install from https://ollama.com/download, then: ollama pull qwen2.5:3b-instruct
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Timeout (seconds) for any AI provider HTTP call.
AURA_LLM_TIMEOUT=20

# ---------------------------------------------------------------------
# Identity / personality
# ---------------------------------------------------------------------
# AURA_NAME is also the wake word — saying it (optionally preceded by
# "hey" and/or followed by "wake up") is what wakes AURA from SLEEPING.
# Change this if you want a different wake word; keep it a single,
# distinctive word for reliable wake-word matching.
AURA_NAME=AURA
AURA_OWNER_NAME=
AURA_OWNER_ROLE=Developer
AURA_PROJECT_NAME=AURA Personal Desktop Assistant

# ---------------------------------------------------------------------
# Voice — wake word / listening / sessions
# ---------------------------------------------------------------------
# How long (seconds) AURA stays ACTIVE (listening for real commands,
# no wake word needed) after the last thing you said or typed, before
# quietly returning to SLEEPING and requiring the wake word again.
AURA_SESSION_TIMEOUT_SECONDS=120

# How long (seconds) AURA waits for a yes/no reply to a confirmation
# question before defaulting to cancellation. Spec recommends 10-15.
AURA_CONFIRMATION_TIMEOUT_SECONDS=12

# RMS energy threshold (0.0-1.0) used to detect "the user started/stopped
# talking" during ACTIVE-state command capture. The default is a
# reasonable starting point but WILL likely need tuning to your actual
# microphone and room noise — turn this up if AURA keeps capturing
# background noise as a command, turn it down if it's clipping the
# start of what you say.
AURA_VAD_ENERGY_THRESHOLD=0.012

# ---------------------------------------------------------------------
# Text-to-speech
# ---------------------------------------------------------------------
# Which TTS engine to use: piper | pyttsx3 | auto
# - piper   : neural TTS via the piper-tts Python package, loaded once
#             at startup and synthesized in-memory (no subprocess, no
#             disk round-trip per response — this is what keeps replies
#             from having a multi-second delay before speaking). Needs
#             PIPER_MODEL_PATH set to a downloaded .onnx voice.
# - pyttsx3 : the original engine, driving installed Windows SAPI5
#             voices. Zero extra downloads.
# - auto    : use Piper if PIPER_MODEL_PATH is set and loads successfully,
#             otherwise fall back to pyttsx3. This is the default.
AURA_TTS_ENGINE=auto

# --- Piper ---
# Download a voice (e.g. from the piper-voices collection) — you need
# both the .onnx model and its matching .onnx.json config, e.g.:
#   PIPER_MODEL_PATH=voices/en_US-lessac-medium.onnx
#   PIPER_CONFIG_PATH=voices/en_US-lessac-medium.onnx.json  (optional if
#     it sits right next to the model with the same name + .json)
PIPER_MODEL_PATH=
PIPER_CONFIG_PATH=
# Piper's own speaking-rate control: 1.0 = the model's natural pace,
# >1.0 = slower, <1.0 = faster.
PIPER_LENGTH_SCALE=1.0

# --- pyttsx3 (used when AURA_TTS_ENGINE=pyttsx3, or as the auto fallback) ---
# Optional exact/partial voice name or id to force a specific installed
# SAPI5 voice (e.g. "Zira" or "Microsoft Zira Desktop"). Leave blank to
# auto-select — AURA prefers an English female-sounding voice (matching
# names like Zira/Jenny/Aria/Samantha/Hazel/"female") if one is
# installed, otherwise falls back to whatever's available.
AURA_TTS_VOICE=
# Speaking rate in words per minute. 175 is a natural, unhurried pace —
# avoid pushing this much higher, it starts to sound rushed.
AURA_TTS_RATE=175

# Volume from 0.0 to 1.0 — applies to both Piper and pyttsx3.
AURA_TTS_VOLUME=1.0
